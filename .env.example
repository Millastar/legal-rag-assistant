# OpenAI-compatible LLM endpoint (LMDeploy by default)
LLM_API_BASE=http://localhost:23333/v1
LLM_API_KEY=EMPTY
LLM_MODEL=Qwen--Qwen2.5-7B-Instruct-law
LLM_CONTEXT_WINDOW=4096

# Hugging Face model IDs or local paths
EMBEDDING_MODEL=sungw111/text2vec-base-chinese-sentence
RERANK_MODEL=BAAI/bge-reranker-large

# Retrieval settings
RETRIEVAL_TOP_K=10
RERANK_TOP_K=3
RERANK_SCORE_THRESHOLD=0.4
COLLECTION_NAME=chinese_labor_laws

# Relative paths are resolved from the repository root
DATA_DIR=data
CACHE_DIR=.cache

